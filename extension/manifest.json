{
  "manifest_version": 3,
  "name": "Authenticator Companion for Google Authenticator™",
  "version": "1.0.1",
  "description": "Unofficial open-source companion for Google Authenticator™. Sync accounts and fill 2FA codes. Not affiliated with Google.",
  "minimum_chrome_version": "127",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting",
    "alarms",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://android.clients.google.com/*",
    "https://passbox-pa.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Authenticator Companion for Google Authenticator™",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "incognito": "not_allowed",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "short_name": "Authenticator Companion",
  "homepage_url": "https://google-auth-for-chrome.exevio.com/"
}
